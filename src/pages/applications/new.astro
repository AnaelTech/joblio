---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { ArrowLeft, Plus, Upload } from "lucide-react";
import { createApplication, deleteApplication } from "@/features/applications/actions";
import { createApplicationSchema } from "@/features/applications/schema";
import {
	SOURCE_LABELS,
	STATUS_LABELS,
	PRIORITY_LABELS,
	REMOTE_LABELS,
} from "@/features/applications/schema";
import { getTags } from "@/features/tags/queries";
import { uploadDocument } from "@/features/documents/actions";
import FormError from "@/components/FormError.astro";

const userId = Astro.locals.user?.id;
const allTags = await getTags();

let errors: Record<string, string> = {};
let globalError = "";
const values: Record<string, string> = {
	companyName: "",
	title: "",
	source: "linkedin",
	status: "applied",
	priority: "medium",
	location: "",
	remoteType: "",
	notes: "",
};
let tagIds: string[] = [];

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();

	const raw: Record<string, string> = {};
	for (const key of formData.keys()) {
		const val = formData.get(key);
		if (typeof val === "string") raw[key] = val;
	}
	Object.assign(values, raw);

	const parsed = createApplicationSchema.safeParse(raw);
	if (parsed.success) tagIds = parsed.data.tagIds ?? [];

	if (parsed.success) {
		const resume = formData.get("resume") as File | null;
		const coverLetter = formData.get("cover_letter") as File | null;

		const MAX_SIZE = 10 * 1024 * 1024;
		const ALLOWED_EXTS = [".pdf", ".png", ".jpg", ".jpeg", ".webp"];

		let fileError = "";
		for (const [label, file] of [
			["CV", resume],
			["Lettre de motivation", coverLetter],
		] as const) {
			if (file && file.size > 0) {
				const ext = "." + file.name.split(".").pop()?.toLowerCase();
				if (file.size > MAX_SIZE) {
					fileError = `${label} : le fichier ne doit pas dépasser 10 Mo`;
					break;
				}
				if (!ALLOWED_EXTS.includes(ext)) {
					fileError = `${label} : format non autorisé (PDF, PNG, JPG, WebP)`;
					break;
				}
			}
		}

		if (fileError) {
			globalError = fileError;
		} else {
			const result = await createApplication(userId, parsed.data);

			if (result.success) {
				const uploadErrors: string[] = [];

				if (resume && resume.size > 0) {
					const r = await uploadDocument(result.id, "resume", resume);
					if (!r.success) {
						uploadErrors.push(`CV : ${r.error}`);
					}
				}
				if (coverLetter && coverLetter.size > 0) {
					const r = await uploadDocument(
						result.id,
						"cover_letter",
						coverLetter,
					);
					if (!r.success) {
						uploadErrors.push(`Lettre de motivation : ${r.error}`);
					}
				}

				if (uploadErrors.length > 0) {
					deleteApplication(result.id, userId);
					globalError = uploadErrors.join(" | ");
				} else {
					return Astro.redirect("/applications");
				}
			} else {
				globalError = result.error;
			}
		}
	} else {
		for (const issue of parsed.error.issues) {
			const path = issue.path.join(".");
			if (!errors[path]) {
				errors[path] = issue.message;
			}
		}
	}
}
---

<AppLayout title="Nouvelle candidature - Joblio">
  <div class="mx-auto max-w-4xl">
    <a
      href="/applications"
      class="mb-6 inline-flex items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground"
    >
      <ArrowLeft className="h-4 w-4" />
      Retour aux candidatures
    </a>

    <h1 class="text-2xl font-bold tracking-tight">Nouvelle candidature</h1>
    <p class="mt-1 text-muted-foreground">
      Ajoutez une nouvelle candidature à votre suivi
    </p>

    <FormError message={globalError} />

    <Card className="mt-6">
      <CardContent className="pt-6">
        <form method="POST" enctype="multipart/form-data" class="space-y-10">
          <input type="hidden" name="tagIds" id="tagIds" value={JSON.stringify(tagIds)} />

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="companyName" class="mb-2 block text-sm font-medium">Entreprise <span class="text-red-500">*</span></label>
              <input id="companyName" name="companyName" type="text" required value={values.companyName} class="input" placeholder="Nom de l'entreprise" />
              {errors.companyName && <p class="mt-1 text-xs text-red-500">{errors.companyName}</p>}
            </div>

            <div class="sm:col-span-2">
              <label for="title" class="mb-2 block text-sm font-medium">Poste <span class="text-red-500">*</span></label>
              <input id="title" name="title" type="text" required value={values.title} class="input" placeholder="Intitulé du poste" />
              {errors.title && <p class="mt-1 text-xs text-red-500">{errors.title}</p>}
            </div>

            <div>
              <label for="source" class="mb-2 block text-sm font-medium">Source <span class="text-red-500">*</span></label>
              <select id="source" name="source" required class="input">
                {Object.entries(SOURCE_LABELS).map(([value, label]) => (
                  <option value={value} selected={values.source === value}>{label}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="status" class="mb-2 block text-sm font-medium">Statut</label>
              <select id="status" name="status" class="input">
                {Object.entries(STATUS_LABELS).map(([value, label]) => (
                  <option value={value} selected={values.status === value}>{label}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="priority" class="mb-2 block text-sm font-medium">Priorité</label>
              <select id="priority" name="priority" class="input">
                {Object.entries(PRIORITY_LABELS).map(([value, label]) => (
                  <option value={value} selected={values.priority === value}>{label}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="remoteType" class="mb-2 block text-sm font-medium">Type de télétravail</label>
              <select id="remoteType" name="remoteType" class="input">
                <option value="" selected={values.remoteType === ""}>Non précisé</option>
                {Object.entries(REMOTE_LABELS).map(([value, label]) => (
                  <option value={value} selected={values.remoteType === value}>{label}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="location" class="mb-2 block text-sm font-medium">Localisation</label>
              <input id="location" name="location" type="text" value={values.location} class="input" placeholder="Ville, pays" />
            </div>

            <div class="sm:col-span-2">
              <label class="mb-2 block text-sm font-medium">Tags</label>
              <div class="flex flex-wrap gap-2">
                {allTags.map((tag) => {
                  const checked = tagIds.includes(tag.id);
                  return (
                    <label
                      class={`inline-flex cursor-pointer items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium transition-colors ${
                        checked
                          ? "ring-1 ring-foreground"
                          : "ring-1 ring-transparent hover:ring-muted-foreground"
                      }`}
                      style={{
                        backgroundColor: tag.color ? `${tag.color}20` : undefined,
                        color: tag.color ?? undefined,
                      }}
                    >
                      <input type="checkbox" checked={checked} data-tag-id={tag.id} class="hidden" />
                      {tag.name}
                    </label>
                  );
                })}
                {allTags.length === 0 && (
                  <p class="text-xs text-muted-foreground">
                    Aucun tag. <a href="/tags/new" class="text-primary hover:underline">Créez-en un</a> d'abord.
                  </p>
                )}
              </div>
            </div>
          </div>

          <div class="pt-4">
            <label for="notes" class="mb-2 block text-sm font-medium">Notes</label>
            <textarea id="notes" name="notes" class="textarea" placeholder="Informations complémentaires...">{values.notes}</textarea>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="resume" class="mb-2 flex items-center gap-1.5 text-sm font-medium">
                <Upload className="h-4 w-4" />
                CV
              </label>
              <input id="resume" name="resume" type="file" accept=".pdf,.png,.jpg,.jpeg,.webp" class="block w-full file:mr-3 file:h-8 file:rounded-lg file:border-0 file:bg-muted file:px-3 file:text-sm file:font-medium file:text-foreground hover:file:bg-muted/80" />
              <p class="mt-1 text-[10px] text-muted-foreground">Max. 10 Mo — PDF, PNG, JPG, WebP</p>
            </div>
            <div>
              <label for="cover_letter" class="mb-2 flex items-center gap-1.5 text-sm font-medium">
                <Upload className="h-4 w-4" />
                Lettre de motivation
              </label>
              <input id="cover_letter" name="cover_letter" type="file" accept=".pdf,.png,.jpg,.jpeg,.webp" class="block w-full file:mr-3 file:h-8 file:rounded-lg file:border-0 file:bg-muted file:px-3 file:text-sm file:font-medium file:text-foreground hover:file:bg-muted/80" />
              <p class="mt-1 text-[10px] text-muted-foreground">Max. 10 Mo — PDF, PNG, JPG, WebP</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <button type="submit" class="btn-primary">
              <Plus className="h-4 w-4" />
              Créer la candidature
            </button>
            <a href="/applications" class="btn-ghost">Annuler</a>
          </div>
        </form>
      </CardContent>
    </Card>
  </div>
</AppLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const hiddenInput = document.getElementById("tagIds");
    if (!hiddenInput) return;
    const checkboxes = document.querySelectorAll("[data-tag-id]");
    checkboxes.forEach((cb) => {
      cb.addEventListener("change", () => {
        const ids = [];
        checkboxes.forEach((c) => {
          if (c.checked) ids.push(c.dataset.tagId);
        });
        hiddenInput.value = JSON.stringify(ids);
      });
    });
  });
</script>

<style is:global>
  .input { height: 2rem; width: 100%; min-width: 0; border-radius: 0.5rem; border: 1px solid hsl(var(--border)); background: transparent; padding: 0.25rem 0.625rem; font-size: 0.875rem; transition: all 0.15s; outline: none; }
  .input::placeholder { color: hsl(var(--muted-foreground)); }
  .input:focus-visible { border-color: hsl(var(--ring)); box-shadow: 0 0 0 3px hsl(var(--ring) / 0.5); }
  .textarea { display: flex; min-height: 4rem; width: 100%; border-radius: 0.5rem; border: 1px solid hsl(var(--border)); background: transparent; padding: 0.5rem 0.625rem; font-size: 0.875rem; transition: all 0.15s; outline: none; }
  .textarea::placeholder { color: hsl(var(--muted-foreground)); }
  .textarea:focus-visible { border-color: hsl(var(--ring)); box-shadow: 0 0 0 3px hsl(var(--ring) / 0.5); }
  .btn-ghost { display: inline-flex; height: 2rem; align-items: center; justify-content: center; border-radius: 0.5rem; padding: 0 1rem; font-size: 0.875rem; font-weight: 500; color: hsl(var(--muted-foreground)); transition: all 0.15s; }
  .btn-ghost:hover { background: hsl(var(--muted)); }
</style>
