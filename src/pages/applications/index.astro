---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import { Search, Plus, X } from "lucide-react";
import { getApplications } from "@/features/applications/queries";
import {
  STATUS_LABELS,
  PRIORITY_LABELS,
} from "@/features/applications/constants";
import ApplicationsPage from "@/features/applications/components/ApplicationsPage";
import type { ApplicationData } from "@/features/applications/components/ApplicationModal";

const search = Astro.url.searchParams.get("q") ?? "";
const statusFilter = Astro.url.searchParams.get("status") ?? "";
const priorityFilter = Astro.url.searchParams.get("priority") ?? "";
const archivedFilter = Astro.url.searchParams.get("archived") ?? "";

const rows = await getApplications({
  search: search || undefined,
  status: statusFilter || undefined,
  priority: priorityFilter || undefined,
  archived: archivedFilter || undefined,
});

const hasFilters = Boolean(search || statusFilter || priorityFilter || archivedFilter);
const inputClass = "h-8 w-full min-w-0 rounded-lg border border-input bg-transparent px-2.5 py-1 text-base transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 md:text-sm";

const initialData: ApplicationData[] = rows.map((app) => ({
  ...app,
  applicationDate: app.applicationDate
    ? app.applicationDate instanceof Date
      ? app.applicationDate.toISOString()
      : String(app.applicationDate)
    : null,
  followUpDate: app.followUpDate
    ? app.followUpDate instanceof Date
      ? app.followUpDate.toISOString()
      : String(app.followUpDate)
    : null,
  createdAt: app.createdAt instanceof Date
    ? app.createdAt.toISOString()
    : String(app.createdAt),
}));
---

<AppLayout title="Applications - Joblio">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Candidatures</h1>
        <p class="text-muted-foreground">Gérez l'ensemble de vos candidatures</p>
      </div>
      <a href="/applications/new" class="btn-primary">
        <Plus class="h-4 w-4" />
        <span class="hidden sm:inline">Nouvelle candidature</span>
        <span class="sm:hidden">Ajouter</span>
      </a>
    </div>

    <form method="GET" id="filter-form" class="flex flex-wrap items-end gap-3">
      <div class="relative min-w-0 flex-1 basis-50">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5">
          <Search class="h-4 w-4 text-muted-foreground" />
        </div>
        <input
          name="q" placeholder="Rechercher par titre ou entreprise..." value={search}
          class={`${inputClass} pl-8`}
        />
      </div>

      <select name="status" class={`${inputClass} w-full md:w-auto md:max-w-40`}>
        <option value="" selected={statusFilter === ""}>Tous les statuts</option>
        {Object.entries(STATUS_LABELS).map(([v, l]) => (
          <option value={v} selected={statusFilter === v}>{l}</option>
        ))}
      </select>

      <select name="priority" class={`${inputClass} w-full md:w-auto md:max-w-35`}>
        <option value="" selected={priorityFilter === ""}>Toutes priorités</option>
        {Object.entries(PRIORITY_LABELS).map(([v, l]) => (
          <option value={v} selected={priorityFilter === v}>{l}</option>
        ))}
      </select>

      <label class="flex h-8 shrink-0 cursor-pointer items-center gap-1.5 rounded-lg border border-input px-2.5 text-sm transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 has-[:checked]:text-blue-700">
        <input type="checkbox" name="archived" value="true" class="size-4 accent-blue-600" checked={archivedFilter === "true"} />
        Archivées
      </label>

      {hasFilters && (
        <a href="/applications" class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-input px-2.5 text-sm text-muted-foreground transition-colors hover:text-foreground">
          <X class="h-4 w-4" /> Réinitialiser
        </a>
      )}
    </form>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("filter-form");
        if (!form) return;
        let debounceTimer;
        const q = form.querySelector("[name=q]");
        const status = form.querySelector("[name=status]");
        const priority = form.querySelector("[name=priority]");
        const archived = form.querySelector("[name=archived]");
        const submit = () => form.requestSubmit();
        q?.addEventListener("input", () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(submit, 300);
        });
        status?.addEventListener("change", submit);
        priority?.addEventListener("change", submit);
        archived?.addEventListener("change", submit);
      });
    </script>

    <ApplicationsPage initialData={initialData} archived={archivedFilter} client:load />
  </div>
</AppLayout>

<style is:global>
  .btn-primary { display: inline-flex; height: 2rem; align-items: center; justify-content: center; gap: 0.375rem; border-radius: 0.5rem; background: hsl(var(--primary)); padding: 0 0.75rem; font-size: 0.875rem; font-weight: 500; color: hsl(var(--primary-foreground)); transition: background 0.15s; border: none; cursor: pointer; }
  .btn-primary:hover { background: hsl(var(--primary) / 0.8); }
</style>
