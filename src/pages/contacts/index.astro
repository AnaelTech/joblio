---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import EmptyState from "@/components/EmptyState.astro";
import { ContactRound, Plus, X, Building2 } from "lucide-react";
import { getContacts, getCompanyOptions } from "@/features/contacts/queries";
import ContactsPage from "@/features/contacts/components/ContactsPage";
import SearchInput from "@/components/SearchInput.astro";

const search = Astro.url.searchParams.get("q") ?? "";
const companyFilter = Astro.url.searchParams.get("companyId") ?? "";
const companyOptions = await getCompanyOptions();

const rows = await getContacts({
	search: search || undefined,
	companyId: companyFilter || undefined,
});

const hasFilters = Boolean(search || companyFilter);

const inputClass =
	"h-8 w-full min-w-0 rounded-lg border border-input bg-transparent px-2.5 py-1 text-base transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 md:text-sm";
---

<AppLayout title="Contacts - Joblio">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Contacts</h1>
        <p class="text-muted-foreground">Gérez vos contacts professionnels</p>
      </div>
      <a href="/contacts/new" class="btn-primary">
        <Plus class="h-4 w-4" />
        <span class="hidden sm:inline">Nouveau contact</span>
        <span class="sm:hidden">Ajouter</span>
      </a>
    </div>

    <form method="GET" id="filter-form" class="flex flex-wrap items-end gap-3">
      <SearchInput placeholder="Rechercher par nom, email ou entreprise..." value={search} class="relative min-w-0 flex-1 basis-[200px]" />

      <select name="companyId" class={`${inputClass} max-w-[200px]`}>
        <option value="" selected={companyFilter === ""}>
          Toutes les entreprises
        </option>
        {companyOptions.map((c) => (
          <option key={c.id} value={c.id} selected={companyFilter === c.id}>
            {c.name}
          </option>
        ))}
      </select>

      {hasFilters && (
        <a
          href="/contacts"
          class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-input px-2.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          <X class="h-4 w-4" /> Réinitialiser
        </a>
      )}
    </form>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("filter-form");
        if (!form) return;
        form
          .querySelector("[name=companyId]")
          ?.addEventListener("change", () => form.requestSubmit());
      });
    </script>

    {rows.length > 0 ? (
      <ContactsPage client:load initialData={rows} />
    ) : (
      <EmptyState
        title="Aucun contact"
        description={
          hasFilters
            ? "Aucun résultat ne correspond aux filtres sélectionnés."
            : "Commencez par ajouter votre premier contact."
        }
        createHref="/contacts/new"
        createLabel="Nouveau contact"
        hasFilters={hasFilters}
      >
        <Fragment slot="icon">
          <ContactRound class="h-6 w-6 text-muted-foreground" />
        </Fragment>
      </EmptyState>
    )}
  </div>
</AppLayout>
