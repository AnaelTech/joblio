---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { ArrowLeft, Plus } from "lucide-react";
import { createTag } from "@/features/tags/actions";
import { createTagSchema } from "@/features/tags/schema";
import { TAG_COLORS } from "@/features/tags/schema";
import { handleForm } from "@/lib/form";
import FormError from "@/components/FormError.astro";

let errors: Record<string, string> = {};
let globalError = "";
const values: Record<string, string> = { name: "", color: "" };

if (Astro.request.method === "POST") {
	const result = await handleForm(
		Astro.request,
		createTagSchema,
		(data) => createTag(data),
		values,
	);

	if (result.success) return Astro.redirect("/tags");

	errors = result.errors;
	globalError = result.globalError;
	Object.assign(values, result.values);
}
---

<AppLayout title="Nouveau tag - Joblio">
  <div class="mx-auto max-w-2xl">
    <a href="/tags" class="mb-6 inline-flex items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground">
      <ArrowLeft class="h-4 w-4" /> Retour aux tags
    </a>

    <h1 class="text-2xl font-bold tracking-tight">Nouveau tag</h1>
    <p class="mt-1 text-muted-foreground">Ajoutez un tag pour catégoriser vos candidatures</p>

    <FormError message={globalError} />

    <Card class="mt-6">
      <CardContent class="pt-6">
        <form method="POST" class="space-y-10">
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="name" class="mb-2 block text-sm font-medium">Nom <span class="text-red-500">*</span></label>
              <input id="name" name="name" type="text" required value={values.name} class="input" placeholder="ex: Frontend, Urgent, À relancer" />
              {errors.name && <p class="mt-1 text-xs text-red-500">{errors.name}</p>}
            </div>

            <div class="sm:col-span-2">
              <label for="color" class="mb-2 block text-sm font-medium">Couleur</label>
              <div class="flex flex-wrap gap-3">
                {TAG_COLORS.map((c) => (
                  <label key={c.value} class="flex cursor-pointer items-center gap-2 rounded-lg border border-input px-3 py-2 text-sm has-[input:checked]:border-primary has-[input:checked]:bg-primary/5">
                    <input type="radio" name="color" value={c.value}
                      checked={values.color === c.value}
                      class="sr-only" />
                    {c.value ? (
                      <div class="h-4 w-4 rounded-full" style={`background-color: ${c.value}`} />
                    ) : (
                      <div class="h-4 w-4 rounded-full border border-dashed border-muted-foreground" />
                    )}
                    <span>{c.label}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <button type="submit" class="btn-primary">
              <Plus class="h-4 w-4" /> Créer le tag
            </button>
            <a href="/tags" class="btn-ghost">Annuler</a>
          </div>
        </form>
      </CardContent>
    </Card>
  </div>
</AppLayout>

<style is:global>
  .input { height: 2rem; width: 100%; min-width: 0; border-radius: 0.5rem; border: 1px solid hsl(var(--border)); background: transparent; padding: 0.25rem 0.625rem; font-size: 0.875rem; transition: all 0.15s; outline: none; }
  .input::placeholder { color: hsl(var(--muted-foreground)); }
  .input:focus-visible { border-color: hsl(var(--ring)); box-shadow: 0 0 0 3px hsl(var(--ring) / 0.5); }
  .btn-ghost { display: inline-flex; height: 2rem; align-items: center; justify-content: center; border-radius: 0.5rem; padding: 0 1rem; font-size: 0.875rem; font-weight: 500; color: hsl(var(--muted-foreground)); transition: all 0.15s; }
  .btn-ghost:hover { background: hsl(var(--muted)); }
</style>
