---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import EmptyState from "@/components/EmptyState.astro";
import { Tags, Plus, X } from "lucide-react";
import { getTags } from "@/features/tags/queries";
import SearchInput from "@/components/SearchInput.astro";

const search = Astro.url.searchParams.get("q") ?? "";
const rows = await getTags(search || undefined);
const hasFilters = Boolean(search);
---

<AppLayout title="Tags - Joblio">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Tags</h1>
        <p class="text-muted-foreground">Gérez vos tags pour catégoriser les candidatures</p>
      </div>
      <a href="/tags/new" class="btn-primary">
        <Plus class="h-4 w-4" />
        <span class="hidden sm:inline">Nouveau tag</span>
        <span class="sm:hidden">Ajouter</span>
      </a>
    </div>

    <form method="GET" id="filter-form" class="flex flex-wrap items-end gap-3">
      <SearchInput placeholder="Rechercher un tag..." value={search} class="relative min-w-0 flex-1 basis-[200px]" />
      {hasFilters && (
        <a href="/tags" class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-input px-2.5 text-sm text-muted-foreground transition-colors hover:text-foreground">
          <X class="h-4 w-4" /> Réinitialiser
        </a>
      )}
    </form>


    {rows.length > 0 ? (
      <Card>
        <CardContent class="p-0">
          <div class="grid gap-3 p-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            {rows.map((t) => (
              <div key={t.id} class="flex items-center gap-3 rounded-lg border p-3 transition-colors hover:bg-muted/50">
                <div class="h-4 w-4 shrink-0 rounded-full" style={t.color ? `background-color: ${t.color}` : "background-color: #e2e8f0"} />
                <span class="text-sm font-medium">{t.name}</span>
              </div>
            ))}
          </div>
        </CardContent>
      </Card>
    ) : (
      <EmptyState
        title="Aucun tag"
        description={search ? `Aucun résultat pour "${search}"` : "Créez des tags pour organiser vos candidatures."}
        createHref="/tags/new"
        createLabel="Nouveau tag"
        hasFilters={hasFilters}
      >
        <Fragment slot="icon">
          <Tags class="h-6 w-6 text-muted-foreground" />
        </Fragment>
      </EmptyState>
    )}
  </div>
</AppLayout>
