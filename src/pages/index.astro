---
export const prerender = false;

import { hasUsers } from "@/features/auth/actions";

const usersExist = await hasUsers();

if (!usersExist) {
	return Astro.redirect("/setup");
}
---

<!doctype html>
<html lang="fr">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<title>Joblio</title>
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }
		body { font-family: system-ui, -apple-system, sans-serif; background: #f8fafc; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 1rem; color: #0f172a; }
		.card { text-align: center; max-width: 480px; }
		.logo { font-size: 2.5rem; font-weight: 800; letter-spacing: -0.03em; background: linear-gradient(135deg, #3b82f6, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
		h1 { font-size: 1.75rem; font-weight: 700; margin-top: 1rem; }
		p { color: #64748b; font-size: 1rem; line-height: 1.6; margin-top: 0.5rem; }
		.links { display: flex; gap: 0.75rem; justify-content: center; margin-top: 2rem; flex-wrap: wrap; }
		.links a { display: inline-flex; align-items: center; gap: 0.375rem; height: 2.5rem; padding: 0 1.25rem; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 500; text-decoration: none; transition: all 0.15s; }
		.btn-primary { background: #059669; color: #fff; }
		.btn-primary:hover { background: #047857; }
		.btn-ghost { color: #64748b; border: 1px solid #e2e8f0; }
		.btn-ghost:hover { background: #f1f5f9; }
	</style>
</head>
<body>
	<div class="card">
		<div class="logo">Joblio</div>
		<h1>Votre tableau de bord candidatures</h1>
		<p>Suivez vos recherches d'emploi, planifiez vos entretiens et ne ratez aucun follow-up.</p>
		<div class="links">
			<a href="/login" class="btn-primary">Se connecter</a>
			<a href="/applications" class="btn-ghost">Accéder aux candidatures</a>
		</div>
	</div>
</body>
</html>
