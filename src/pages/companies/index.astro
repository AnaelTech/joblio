---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import EmptyState from "@/components/EmptyState.astro";
import { Building2, Plus, Search, X } from "lucide-react";
import { getCompanies } from "@/features/companies/queries";
import CompaniesPage from "@/features/companies/components/CompaniesPage";

const search = Astro.url.searchParams.get("q") ?? "";
const rows = await getCompanies(search || undefined);
const hasFilters = Boolean(search);

const inputClass =
	"h-8 w-full min-w-0 rounded-lg border border-input bg-transparent px-2.5 py-1 text-base transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 md:text-sm";
---

<AppLayout title="Entreprises - Joblio">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Entreprises</h1>
        <p class="text-muted-foreground">Gérez vos entreprises suivies</p>
      </div>
      <a href="/companies/new" class="btn-primary">
        <Plus class="h-4 w-4" />
        <span class="hidden sm:inline">Nouvelle entreprise</span>
        <span class="sm:hidden">Ajouter</span>
      </a>
    </div>

    <div class="flex items-center gap-2">
      <form method="GET" id="filter-form" class="flex-1">
        <div class="relative">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5">
            <Search class="h-4 w-4 text-muted-foreground" />
          </div>
          <input
            name="q"
            placeholder="Rechercher par nom, secteur ou ville..."
            value={search}
            class={`${inputClass} pl-8`}
          />
        </div>
      </form>
      {hasFilters && (
        <a
          href="/companies"
          class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-input px-2.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          <X class="h-4 w-4" /> Réinitialiser
        </a>
      )}
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const form = document.getElementById("filter-form");
        if (!form) return;
        let debounceTimer;
        form.querySelector("[name=q]")?.addEventListener("input", () => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => form.requestSubmit(), 300);
        });
      });
    </script>

    {rows.length > 0 ? (
      <CompaniesPage client:load initialData={rows} />
    ) : (
      <EmptyState
        title="Aucune entreprise"
        description={
          search
            ? `Aucun résultat pour "${search}"`
            : "Commencez par ajouter votre première entreprise."
        }
        createHref="/companies/new"
        createLabel="Nouvelle entreprise"
        hasFilters={hasFilters}
      >
        <Fragment slot="icon">
          <Building2 class="h-6 w-6 text-muted-foreground" />
        </Fragment>
      </EmptyState>
    )}
  </div>
</AppLayout>

<style is:global>
  .btn-primary {
    display: inline-flex;
    height: 2rem;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    border-radius: 0.5rem;
    background: hsl(var(--primary));
    padding: 0 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--primary-foreground));
    transition: background 0.15s;
    border: none;
    cursor: pointer;
  }
  .btn-primary:hover {
    background: hsl(var(--primary) / 0.8);
  }
</style>
