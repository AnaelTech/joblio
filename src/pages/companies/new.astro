---
export const prerender = false;

import AppLayout from "@/layouts/AppLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { ArrowLeft, Plus } from "lucide-react";
import { createCompany } from "@/features/companies/actions";
import { createCompanySchema } from "@/features/companies/schema";
import { handleForm } from "@/lib/form";
import FormError from "@/components/FormError.astro";

let errors: Record<string, string> = {};
let globalError = "";
const values: Record<string, string> = { name: "", industry: "", size: "", location: "", website: "", linkedin: "" };

if (Astro.request.method === "POST") {
  const result = await handleForm(
    Astro.request,
    createCompanySchema,
    (data) => createCompany(data),
    values,
  );

  if (result.success) return Astro.redirect("/companies");

  errors = result.errors;
  globalError = result.globalError;
  Object.assign(values, result.values);
}
---

<AppLayout title="Nouvelle entreprise - Joblio">
  <div class="mx-auto max-w-4xl">
    <a href="/companies" class="mb-6 inline-flex items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground">
      <ArrowLeft class="h-4 w-4" /> Retour aux entreprises
    </a>

    <h1 class="text-2xl font-bold tracking-tight">Nouvelle entreprise</h1>
    <p class="mt-1 text-muted-foreground">Ajoutez une nouvelle entreprise à votre suivi</p>

    <FormError message={globalError} />

    <Card class="mt-6">
      <CardContent class="pt-6">
        <form method="POST" class="space-y-10">
          <div class="grid gap-6 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="name" class="mb-2 block text-sm font-medium">Nom <span class="text-red-500">*</span></label>
              <input id="name" name="name" type="text" required value={values.name} class="input" placeholder="Nom de l'entreprise" />
              {errors.name && <p class="mt-1 text-xs text-red-500">{errors.name}</p>}
            </div>

            <div>
              <label for="industry" class="mb-2 block text-sm font-medium">Secteur</label>
              <input id="industry" name="industry" type="text" value={values.industry} class="input" placeholder="Tech, Finance, ..." />
            </div>

            <div>
              <label for="size" class="mb-2 block text-sm font-medium">Taille</label>
              <input id="size" name="size" type="text" value={values.size} class="input" placeholder="PME, ETI, Grande entreprise" />
            </div>

            <div>
              <label for="location" class="mb-2 block text-sm font-medium">Localisation</label>
              <input id="location" name="location" type="text" value={values.location} class="input" placeholder="Ville, pays" />
            </div>

            <div>
              <label for="website" class="mb-2 block text-sm font-medium">Site web</label>
              <input id="website" name="website" type="url" value={values.website} class="input" placeholder="https://example.com" />
              {errors.website && <p class="mt-1 text-xs text-red-500">{errors.website}</p>}
            </div>

            <div>
              <label for="linkedin" class="mb-2 block text-sm font-medium">LinkedIn</label>
              <input id="linkedin" name="linkedin" type="url" value={values.linkedin} class="input" placeholder="https://linkedin.com/company/..." />
              {errors.linkedin && <p class="mt-1 text-xs text-red-500">{errors.linkedin}</p>}
            </div>
          </div>

          <div class="flex items-center gap-3">
            <button type="submit" class="btn-primary">
              <Plus class="h-4 w-4" /> Créer l'entreprise
            </button>
            <a href="/companies" class="btn-ghost">Annuler</a>
          </div>
        </form>
      </CardContent>
    </Card>
  </div>
</AppLayout>

<style is:global>
  .input { height: 2rem; width: 100%; min-width: 0; border-radius: 0.5rem; border: 1px solid hsl(var(--border)); background: transparent; padding: 0.25rem 0.625rem; font-size: 0.875rem; transition: all 0.15s; outline: none; }
  .input::placeholder { color: hsl(var(--muted-foreground)); }
  .input:focus-visible { border-color: hsl(var(--ring)); box-shadow: 0 0 0 3px hsl(var(--ring) / 0.5); }
  .btn-primary { display: inline-flex; height: 2rem; align-items: center; justify-content: center; gap: 0.375rem; border-radius: 0.5rem; background: hsl(var(--primary)); padding: 0 1rem; font-size: 0.875rem; font-weight: 500; color: hsl(var(--primary-foreground)); transition: background 0.15s; border: none; cursor: pointer; }
  .btn-primary:hover { background: hsl(var(--primary) / 0.8); }
  .btn-ghost { display: inline-flex; height: 2rem; align-items: center; justify-content: center; border-radius: 0.5rem; padding: 0 1rem; font-size: 0.875rem; font-weight: 500; color: hsl(var(--muted-foreground)); transition: all 0.15s; }
  .btn-ghost:hover { background: hsl(var(--muted)); }
</style>
