---
import TooltipProvider from "../components/providers/TooltipProvider";
import AppSidebarLayout from "../layouts/AppSidebarLayout";
import ClientRouter from "astro/components/ClientRouter.astro";
import PushSetup from "@/features/notifications/components/PushSetup";

import "../styles/global.css";

const { title = "Joblio" } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="fr">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
	<meta name="theme-color" content="#059669" />
	<meta name="mobile-web-app-capable" content="yes" />
	<meta name="apple-mobile-web-app-status-bar-style" content="default" />
	<meta name="apple-mobile-web-app-title" content="Joblio" />
	<link rel="manifest" href="/manifest.webmanifest" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" href="/favicon.ico" />
	<link rel="apple-touch-icon" href="/pwa-icons/icon-192x192.png" />
	<link rel="apple-touch-startup-image" href="/pwa-icons/icon-512x512.png" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3)" />
	<ClientRouter />
	<title>{title}</title>
	<script is:inline>
		(function() {
			const theme = localStorage.getItem("theme") ?? "system";
			const isDark = theme === "dark" || (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
			if (isDark) document.documentElement.classList.add("dark");
		})();
	</script>
	<script is:inline>
		document.addEventListener("astro:after-swap", function() {
			const theme = localStorage.getItem("theme") ?? "system";
			const isDark = theme === "dark" || (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
			document.documentElement.classList.toggle("dark", isDark);
		});
	</script>
	<style>
		#nprogress {
			pointer-events: none;
			position: fixed;
			inset: 0 0 auto;
			z-index: 9999;
			height: 3px;
		}
		#nprogress .bar {
			background: hsl(var(--primary));
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			transform-origin: 0 50%;
			animation: nprogress-indeterminate 2s ease-in-out infinite;
		}
		@keyframes nprogress-indeterminate {
			0%   { transform: translateX(-100%) scaleX(0.3); }
			40%  { transform: translateX(0%)    scaleX(0.6); }
			100% { transform: translateX(300%)  scaleX(0.3); }
		}
		#nprogress.hidden { display: none; }
	</style>
</head>

<body>

	<div id="nprogress" class="hidden" aria-hidden="true"><div class="bar"></div></div>

	<script>
		const el = document.getElementById("nprogress");
		let timeout;

		document.addEventListener("astro:before-preparation", () => {
			clearTimeout(timeout);
			el?.classList.remove("hidden");
		});

		document.addEventListener("astro:after-swap", () => {
			timeout = setTimeout(() => el?.classList.add("hidden"), 300);
		});
	</script>

	<TooltipProvider client:load>

		<AppSidebarLayout user={user} client:load>
			<main class="md:p-6">
				<slot />
			</main>

		</AppSidebarLayout>

	</TooltipProvider>

	<script is:inline>
		if ("serviceWorker" in navigator) {
			navigator.serviceWorker.register("/sw.js");
		}
	</script>

	<PushSetup client:load />

</body>

</html>
